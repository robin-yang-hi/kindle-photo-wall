# Kindle 照片墙 · 设备端配置（示例）
# 复制为 env.conf 后按需修改：FTP 上传 env.conf 为 env.conf.new 再写 deploy 即可无线生效，
# 或插数据线直接覆盖 /mnt/us/kindle-photo-wall/device/env.conf

# ---- 天气（示例：北京东城区；改成你自己的城市）----
CITY_CODE=101010101        # 城市代码（中国天气网编码，t.weather.itboy.net 备用源使用）
LAT=39.9042                # 纬度（主数据源 Open-Meteo 按此定位）
LON=116.4074               # 经度

# ---- 运行模式 ----
DASH_MODE=always           # always=常亮（插电，时间分钟级）；sleep=RTC休眠（省电，时间最多旧30分钟）
DASH_INTERVAL=120          # 白天刷新间隔（秒）：120 = 照片每 2 分钟换一张、时间分钟级更新
NIGHT_MODE=1                # 1=开启夜间模式：深夜自动放慢刷新
NIGHT_START=23              # 夜间从几点开始（24小时制）
NIGHT_END=7                  # 夜间到几点结束
NIGHT_INTERVAL=600          # 夜间刷新间隔（秒）
DASH_SLEEP_INTERVAL=1800   # 休眠模式唤醒间隔（秒）
PAINT_SH=paint2.sh         # 画面合成脚本：paint.sh=v1 竖屏旧版式；paint2.sh=v2 横屏双信息带+侧栏
                           # （竖屏时会自动回退 paint.sh，v2 只有横屏坐标）

# ---- 刷屏 ----
WAVE=GL16                  # 平时波形（轻刷不闪）；WAVE_FULL=GC16 清残影
WAVE_FULL=GC16             # 每 FULL_EVERY 帧来一次全刷清残影；启动第一帧也强制全刷
FULL_EVERY=10

# ---- 屏幕 / 灯光 ----
FRONTLIGHT=0               # 前置阅读灯：0=关闭（挂墙最省电）；1~24=亮度

# ---- 横屏 / 竖屏 ----
# 1=横屏 1448x1072（用 assets/layout-land2.sh 坐标）；0=竖屏 1072x1448（layout.sh）
LANDSCAPE=1
FB_ROTATE=0                # 0 和 2 都是横屏、相差 180°。画面倒了改成 2
STOP_UI=1                  # 1=停 framework（推荐，见 DESIGN.md 屏幕所有权）
FREEZE_APP=1               # 冻结 cvm/appmgrd 防弹窗
STOP_POWERD=0              # 0=保留 powerd（推荐；管防休眠与 USB）
KPW_DEBUG=0                # 1=每 5 帧把进程/服务状态写进日志（排查用）

# ---- 省电 ----
WIFI_POWERSAVE=1           # 1=WiFi 省电（默认；实测静置电流近半）
EPDC_POWER=auto            # auto=墨水屏控制器空闲自动挂起（刷新正常）

# ---- 照片 ----
PHOTO_ROTATE_SEC=60        # 每 N 秒换一张；0=每天按日期换一张（相框模式）
PHOTO_NEW_WINDOW=650       # 刚上传的图优先显示多少秒（传完 ≤10 分钟内一定上屏）
PHOTO_FIT=contain          # contain=完整显示留白 / cover=铺满裁边

# ---- 手机推送（FTP）----
FTP_PORT=2121              # 手机 FTP 客户端连 ftp://<kindle-ip>:2121（根目录=照片目录）
FTP_USER=root
FTP_PASS=root              # ⚠️ 会把系统 root 密码一并设为它（busybox ftpd 走系统账户认证），
                           #    原密码备份在 device/etc.shadow.bak；请自行改成强密码
FTP_AUTH=1

# ---- 运维通道（无线改脚本 / 看日志）----
ADMIN_PORT=2122            # 局域网内第二个 FTP（根=整个项目）；设 0 关闭
                           # ⚠️ 有写权限，同一 WiFi 下任何设备都能改脚本，按需开启

# ---- 特殊日子登记网页 ----
ANNIV_WEB=1                # 手机浏览器打开 http://<kindle-ip>:8080/ 填表登记纪念日
ANNIV_WEB_PORT=8080

# ---- 电源键退出 ----
POWER_EXIT=1                # 1=开启三连击退出；0=关闭
POWER_EXIT_PRESSES=3
POWER_PRESS_WINDOW=3
#POWER_DEV=/dev/input/event1  # 电源键 input 节点（默认自动探测）

# ---- 番茄钟 ----
# 待机点按=进入调时确认页（暂停着显示时长）：左按钮 −5分 / 中 开始 / 右 +5分，
#   长按 ± 一次 ±3 步；按「开始」才开跑，所选时长跨会话记忆。
POMO=1
POMO_FOCUS=25              # 调时页初始分钟数（之后记住上次所选）
POMO_STEP=5                # 调时步长（按钮标签烤死 ±5分，改这里需重新生成素材）
POMO_BREAK=5               # 短休分钟数
POMO_LONG=15               # 长休分钟数
POMO_EVERY=4               # 每完成 N 个番茄进入长休
POMO_AUTO=1                # 1=休息结束自动进入下一轮；0=休息完回照片墙待命
#POMO_TS_DEV=/dev/input/event2  # 触摸 input 节点（默认自动探测）
#POMO_LONGPRESS_MS=800
POMO_TOUCH_MAP=5          # 触摸坐标映射（PW4 goodix 实测：屏幕X=rawY、Y=1071-rawX；换机型可能要调）
POMO_REFRESH=10           # 专注模式翻牌刷新间隔（秒）
POMO_FLIP=1               # 翻牌动画开关
POMO_FLIP_DELAY=0.4       # 翻牌落板停顿（秒）

# ---- 固定 IP ----
FIXED_IP=192.168.0.250     # wlan0 别名地址，选路由器 DHCP 池外的；留空=不启用
FIXED_MASK=255.255.255.0
